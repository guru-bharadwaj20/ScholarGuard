# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# Secrets — NCBI_CONTACT_EMAIL / NCBI_API_KEY live here, never in code
.env

# Third-party data clone (63 MB CSV, re-clonable via retraction_watch.py)
retraction-watch-data/

# ---------------------------------------------------------------------------
# Datasets are NEVER committed: they are large (the held-out package set alone
# is ~1.5 GB), exceed GitHub's file-size limits, and are fully re-fetchable via
# scripts/ (fetch_corpus.py, fetch_evaluation_set.py, fetch_heldout_packages.py).
# labels.json manifests are regenerated by those scripts too. Any small sample
# fixtures already committed in history stay as-is; nothing new under data/ is
# added.
# ---------------------------------------------------------------------------
data/

# Manifest scratch files (in case any live outside data/)
*.manifest.tmp

# Model weights (trained on Colab, not versioned)
src/models/weights/*.pt

# Pipeline working outputs (regenerable; headline results live in the README)
outputs/

# Web UI + API bridge
web/node_modules/
web/.next/
web/next-env.d.ts
server/jobs/
server/uploads/
server/__pycache__/

# README screenshots in images/ are intentionally tracked (do not ignore).

# TypeScript incremental build cache
web/tsconfig.tsbuildinfo
